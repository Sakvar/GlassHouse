APP_ENV=development
DATABASE_URL=postgresql+psycopg://glasshouse:glasshouse@postgres:5432/glasshouse
POSTGRES_PASSWORD=glasshouse
# Development uses a fixed local-only default. Production requires a random value >=32 chars.
SESSION_SECRET=
TICK_INTERVAL_SECONDS=120
WORKER_POLL_SECONDS=5
SEASON_LOCALE=ru
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NARRATOR=
OPENROUTER_MODEL_NARRATOR_FALLBACKS=
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=GlassHouse Live
LLM_MAX_CALLS_PER_TICK=1
LLM_MAX_OUTPUT_TOKENS_PER_TICK=600
LLM_MAX_INPUT_CHARS=12000
LLM_TIMEOUT_SECONDS=15
